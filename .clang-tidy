# Mystic Framework Clang-Tidy Configuration

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-dcl50-cpp,
  cert-dcl58-cpp,
  cert-err33-c,
  cert-flp30-c,
  cert-msc50-cpp,
  cert-msc51-cpp,
  cert-oop54-cpp,
  cert-str34-c,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-interfaces-global-init,
  cppcoreguidelines-macro-usage,
  cppcoreguidelines-misleading-capture-default-by-value,
  cppcoreguidelines-missing-std-forward,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-rvalue-reference-param-not-moved,
  cppcoreguidelines-slicing,
  cppcoreguidelines-special-member-functions,
  cppcoreguidelines-virtual-class-destructor,
  google-build-using-namespace,
  google-explicit-constructor,
  google-global-names-in-headers,
  google-runtime-int,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  modernize-*,
  -modernize-concat-nested-namespaces,
  -modernize-use-auto,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  -portability-simd-intrinsics,
  readability-*,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers

# Handle warnings as errors
WarningsAsErrors: '*'

# Only report diagnostics for MFW's own headers (source/public, source/private).
HeaderFilterRegex: '(^|.*/)source/(public|private)/.*'
SystemHeaders: false

# Use the .clang-format in the repo for any fix-its.
FormatStyle: file

CheckOptions:
  # --- Macros: MYSTIC_* prefixed ---
  - key: cppcoreguidelines-macro-usage.AllowedRegexp
    value: '^MYSTIC_.*'

  # --- Rule of Three/Five/Zero ---
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted
    value: true

  # --- Short names that are normal in engine/math code ---
  - key: readability-identifier-length.IgnoredVariableNames
    value: '^(x|y|z|w|u|v|r|g|b|a|i|j|k|n|t|dt|id)$'
  - key: readability-identifier-length.IgnoredParameterNames
    value: '^(x|y|z|w|u|v|r|g|b|a|i|j|k|n|t|dt|id)$'

  # --- Naming ---
  - key: readability-identifier-naming.IgnoreMainLikeFunctions
    value: true

  # Types: PascalCase (classes, structs, enums, unions, aliases, typedefs, template params, concepts)
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase
  - key: readability-identifier-naming.ConceptCase
    value: CamelCase

  # Functions and methods: PascalCase, including getters and setters
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: CamelCase

  # Namespaces: snake_case
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # Variables and parameters: snake_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  # Data members: snake_case with trailing underscore (private/protected/static),
  # public struct members: plain snake_case
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  - key: readability-identifier-naming.ClassMemberCase
    value: lower_case
  - key: readability-identifier-naming.ClassMemberSuffix
    value: '_'

  # Constants: kPascalCase (global, static, class, constexpr, const members)
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: k
  - key: readability-identifier-naming.ConstantMemberCase
    value: CamelCase
  - key: readability-identifier-naming.ConstantMemberPrefix
    value: k

  # Enumerators: kPascalCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k

  # Macros: SCREAMING_SNAKE_CASE with MYSTIC_ prefix except header guards
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionPrefix
    value: MYSTIC_
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '.*_(HPP|H)_$'
